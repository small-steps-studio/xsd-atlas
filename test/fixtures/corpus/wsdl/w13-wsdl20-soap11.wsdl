<?xml version="1.0" encoding="UTF-8"?>
<!-- WSDL 2.0 with a SOAP 1.1 binding (wsoap:version="1.1"). -->
<wsdl:description xmlns:wsdl="http://www.w3.org/ns/wsdl"
                  xmlns:wsoap="http://www.w3.org/ns/wsdl/soap"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="urn:example:meters:read"
                  targetNamespace="urn:example:meters:read">
  <wsdl:types>
    <xs:schema targetNamespace="urn:example:meters:read" elementFormDefault="qualified">
      <xs:element name="ReadMeter"><xs:complexType><xs:sequence><xs:element name="serial" type="xs:token"/></xs:sequence></xs:complexType></xs:element>
      <xs:element name="Reading"><xs:complexType><xs:sequence><xs:element name="kwh" type="xs:decimal"/><xs:element name="at" type="xs:dateTime"/></xs:sequence></xs:complexType></xs:element>
    </xs:schema>
  </wsdl:types>
  <wsdl:interface name="MeterInterface">
    <wsdl:operation name="ReadMeter" pattern="http://www.w3.org/ns/wsdl/in-out">
      <wsdl:input element="tns:ReadMeter"/>
      <wsdl:output element="tns:Reading"/>
    </wsdl:operation>
  </wsdl:interface>
  <wsdl:binding name="MeterSoap11" interface="tns:MeterInterface" type="http://www.w3.org/ns/wsdl/soap" wsoap:version="1.1" wsoap:protocol="http://www.w3.org/2006/01/soap11/bindings/HTTP/">
    <wsdl:operation ref="tns:ReadMeter" wsoap:action="ReadMeter"/>
  </wsdl:binding>
  <wsdl:service name="MeterService" interface="tns:MeterInterface">
    <wsdl:endpoint name="MeterEndpoint" binding="tns:MeterSoap11" address="https://meters.example.com/read"/>
  </wsdl:service>
</wsdl:description>
