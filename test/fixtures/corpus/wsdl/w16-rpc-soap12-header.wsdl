<?xml version="1.0" encoding="UTF-8"?>
<!-- RPC/literal over SOAP 1.2 with a header part of a separate message. -->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="urn:example:clock:rpc"
                  targetNamespace="urn:example:clock:rpc">
  <wsdl:types>
    <xs:schema targetNamespace="urn:example:clock:rpc" elementFormDefault="qualified">
      <xs:element name="Trace"><xs:complexType><xs:sequence><xs:element name="traceId" type="xs:token"/></xs:sequence></xs:complexType></xs:element>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="TimeIn"><wsdl:part name="zone" type="xs:token"/></wsdl:message>
  <wsdl:message name="TimeOut"><wsdl:part name="now" type="xs:dateTime"/></wsdl:message>
  <wsdl:message name="TraceHeader"><wsdl:part name="trace" element="tns:Trace"/></wsdl:message>
  <wsdl:portType name="ClockPort">
    <wsdl:operation name="CurrentTime"><wsdl:input message="tns:TimeIn"/><wsdl:output message="tns:TimeOut"/></wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="ClockSoap12" type="tns:ClockPort">
    <soap12:binding style="rpc" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="CurrentTime">
      <soap12:operation soapAction="urn:example:clock:CurrentTime"/>
      <wsdl:input>
        <soap12:header message="tns:TraceHeader" part="trace" use="literal"/>
        <soap12:body use="literal" namespace="urn:example:clock:rpc"/>
      </wsdl:input>
      <wsdl:output><soap12:body use="literal" namespace="urn:example:clock:rpc"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="ClockService">
    <wsdl:port name="ClockPort" binding="tns:ClockSoap12"><soap12:address location="https://clock.example.com/rpc"/></wsdl:port>
  </wsdl:service>
</wsdl:definitions>
