<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  xmlns:def="urn:example:tickets:defs"
                  targetNamespace="urn:example:tickets:defs">
  <wsdl:types>
    <xs:schema targetNamespace="urn:example:tickets:defs" elementFormDefault="qualified">
      <xs:element name="OpenTicket">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="subject" type="xs:string"/>
            <xs:element name="severity">
              <xs:simpleType><xs:restriction base="xs:int"><xs:minInclusive value="1"/><xs:maxInclusive value="4"/></xs:restriction></xs:simpleType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="TicketOpened"><xs:complexType><xs:sequence><xs:element name="ticketId" type="xs:token"/></xs:sequence></xs:complexType></xs:element>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="OpenIn"><wsdl:part name="p" element="def:OpenTicket"/></wsdl:message>
  <wsdl:message name="OpenOut"><wsdl:part name="p" element="def:TicketOpened"/></wsdl:message>
  <wsdl:portType name="TicketPort">
    <wsdl:operation name="OpenTicket"><wsdl:input message="def:OpenIn"/><wsdl:output message="def:OpenOut"/></wsdl:operation>
  </wsdl:portType>
</wsdl:definitions>
