<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:msg="urn:example:rates:messages"
           targetNamespace="urn:example:rates:messages"
           elementFormDefault="qualified">
  <xs:element name="QuoteRequest">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="from" type="msg:CurrencyCode"/>
        <xs:element name="to" type="msg:CurrencyCode"/>
        <xs:element name="amount" type="xs:decimal"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Quote">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="rate" type="xs:decimal"/>
        <xs:element name="validUntil" type="xs:dateTime"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="CurrencyCode">
    <xs:restriction base="xs:string"><xs:pattern value="[A-Z]{3}"/></xs:restriction>
  </xs:simpleType>
</xs:schema>
