<?xml version="1.0" encoding="UTF-8"?>
<!-- SOAP 1.2 binding, two operations, a named complex type reused. -->
<definitions xmlns="http://schemas.xmlsoap.org/wsdl/"
             xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
             xmlns:xsd="http://www.w3.org/2001/XMLSchema"
             xmlns:led="urn:example:ledger:v2"
             targetNamespace="urn:example:ledger:v2">
  <types>
    <xsd:schema targetNamespace="urn:example:ledger:v2" elementFormDefault="qualified">
      <xsd:complexType name="EntryType">
        <xsd:sequence>
          <xsd:element name="account" type="xsd:token"/>
          <xsd:element name="amount" type="xsd:decimal"/>
          <xsd:element name="side">
            <xsd:simpleType>
              <xsd:restriction base="xsd:token">
                <xsd:enumeration value="debit"/>
                <xsd:enumeration value="credit"/>
              </xsd:restriction>
            </xsd:simpleType>
          </xsd:element>
        </xsd:sequence>
      </xsd:complexType>
      <xsd:element name="PostEntries">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="entry" type="led:EntryType" minOccurs="2" maxOccurs="unbounded"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="PostEntriesResult">
        <xsd:complexType>
          <xsd:sequence><xsd:element name="journalId" type="xsd:token"/></xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="GetBalance">
        <xsd:complexType>
          <xsd:sequence><xsd:element name="account" type="xsd:token"/></xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="Balance" type="xsd:decimal"/>
    </xsd:schema>
  </types>
  <message name="PostEntriesIn"><part name="body" element="led:PostEntries"/></message>
  <message name="PostEntriesOut"><part name="body" element="led:PostEntriesResult"/></message>
  <message name="GetBalanceIn"><part name="body" element="led:GetBalance"/></message>
  <message name="GetBalanceOut"><part name="body" element="led:Balance"/></message>
  <portType name="LedgerPortType">
    <operation name="PostEntries">
      <input message="led:PostEntriesIn"/>
      <output message="led:PostEntriesOut"/>
    </operation>
    <operation name="GetBalance">
      <input message="led:GetBalanceIn"/>
      <output message="led:GetBalanceOut"/>
    </operation>
  </portType>
  <binding name="LedgerSoap12" type="led:LedgerPortType">
    <soap12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="PostEntries">
      <soap12:operation soapAction="urn:example:ledger:PostEntries"/>
      <input><soap12:body use="literal"/></input>
      <output><soap12:body use="literal"/></output>
    </operation>
    <operation name="GetBalance">
      <soap12:operation soapAction="urn:example:ledger:GetBalance"/>
      <input><soap12:body use="literal"/></input>
      <output><soap12:body use="literal"/></output>
    </operation>
  </binding>
  <service name="LedgerService">
    <port name="LedgerSoap12Port" binding="led:LedgerSoap12">
      <soap12:address location="https://ledger.example.org/v2"/>
    </port>
  </service>
</definitions>
