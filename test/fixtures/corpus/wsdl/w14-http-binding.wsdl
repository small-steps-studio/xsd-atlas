<?xml version="1.0" encoding="UTF-8"?>
<!-- A WSDL 1.1 HTTP GET binding next to a SOAP binding. -->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:http="http://schemas.xmlsoap.org/wsdl/http/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  xmlns:tns="urn:example:postcodes"
                  targetNamespace="urn:example:postcodes">
  <wsdl:types>
    <xs:schema targetNamespace="urn:example:postcodes" elementFormDefault="qualified">
      <xs:element name="Lookup"><xs:complexType><xs:sequence><xs:element name="postcode" type="xs:token"/></xs:sequence></xs:complexType></xs:element>
      <xs:element name="Place"><xs:complexType><xs:sequence><xs:element name="town" type="xs:string"/><xs:element name="region" type="xs:string" minOccurs="0"/></xs:sequence></xs:complexType></xs:element>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="LookupIn"><wsdl:part name="p" element="tns:Lookup"/></wsdl:message>
  <wsdl:message name="LookupOut"><wsdl:part name="p" element="tns:Place"/></wsdl:message>
  <wsdl:portType name="PostcodePort">
    <wsdl:operation name="Lookup"><wsdl:input message="tns:LookupIn"/><wsdl:output message="tns:LookupOut"/></wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="PostcodeSoap" type="tns:PostcodePort">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Lookup"><soap:operation soapAction="Lookup"/><wsdl:input><soap:body use="literal"/></wsdl:input><wsdl:output><soap:body use="literal"/></wsdl:output></wsdl:operation>
  </wsdl:binding>
  <wsdl:binding name="PostcodeHttpGet" type="tns:PostcodePort">
    <http:binding verb="GET"/>
    <wsdl:operation name="Lookup">
      <http:operation location="/lookup"/>
      <wsdl:input><http:urlEncoded/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="PostcodeService">
    <wsdl:port name="Soap" binding="tns:PostcodeSoap"><soap:address location="https://postcodes.example.com/soap"/></wsdl:port>
    <wsdl:port name="HttpGet" binding="tns:PostcodeHttpGet"><http:address location="https://postcodes.example.com"/></wsdl:port>
  </wsdl:service>
</wsdl:definitions>
