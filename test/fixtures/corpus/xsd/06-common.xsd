<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:cmn="urn:example:logistics:common:1"
           targetNamespace="urn:example:logistics:common:1"
           elementFormDefault="qualified">
  <xs:complexType name="IdentifierType">
    <xs:simpleContent>
      <xs:extension base="xs:token">
        <xs:attribute name="scheme" type="xs:token"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="WeightType">
    <xs:simpleContent>
      <xs:extension base="cmn:PositiveDecimalType">
        <xs:attribute name="unit" use="required">
          <xs:simpleType>
            <xs:restriction base="xs:token">
              <xs:enumeration value="kg"/>
              <xs:enumeration value="lb"/>
            </xs:restriction>
          </xs:simpleType>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>
  <xs:simpleType name="PositiveDecimalType">
    <xs:restriction base="xs:decimal">
      <xs:minExclusive value="0"/>
      <xs:fractionDigits value="3"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="CountryCodeType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{2}"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
