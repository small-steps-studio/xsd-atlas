<?xml version="1.0" encoding="UTF-8"?>
<!-- Nested choices, a choice with an empty branch, repeated choices and xs:all. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:ch="urn:example:choices:delivery"
           targetNamespace="urn:example:choices:delivery"
           elementFormDefault="qualified">
  <xs:element name="deliveryInstruction">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="reference" type="xs:token"/>
        <xs:choice>
          <xs:element name="homeAddress" type="xs:string"/>
          <xs:sequence>
            <xs:element name="lockerId" type="xs:token"/>
            <xs:element name="pin" type="xs:token" minOccurs="0"/>
          </xs:sequence>
          <xs:element name="pickUpPoint">
            <xs:complexType>
              <xs:choice>
                <xs:element name="shopCode" type="xs:token"/>
                <xs:element name="stationCode" type="xs:token"/>
              </xs:choice>
            </xs:complexType>
          </xs:element>
        </xs:choice>
        <xs:choice minOccurs="0" maxOccurs="3">
          <xs:element name="leaveWithNeighbour" type="xs:string"/>
          <xs:element name="safePlace" type="xs:string"/>
        </xs:choice>
        <xs:element name="preferences" minOccurs="0">
          <xs:complexType>
            <xs:all>
              <xs:element name="morning" type="xs:boolean" minOccurs="0"/>
              <xs:element name="weekend" type="xs:boolean" minOccurs="0"/>
              <xs:element name="signatureRequired" type="xs:boolean"/>
            </xs:all>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
