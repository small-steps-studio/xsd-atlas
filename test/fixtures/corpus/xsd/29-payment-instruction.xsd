<?xml version="1.0" encoding="UTF-8"?>
<!-- An invented payment instruction message with a batch of transfers and a control sum. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:pi="urn:example:treasury:payment:4"
           targetNamespace="urn:example:treasury:payment:4"
           elementFormDefault="qualified">
  <xs:element name="PaymentBatch">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="BatchId" type="pi:Max35Text"/>
        <xs:element name="CreatedAt" type="xs:dateTime"/>
        <xs:element name="NumberOfTransfers" type="xs:positiveInteger"/>
        <xs:element name="ControlSum" type="pi:AmountType"/>
        <xs:element name="Debtor" type="pi:AccountHolderType"/>
        <xs:element name="Transfer" type="pi:TransferType" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="AccountHolderType">
    <xs:sequence>
      <xs:element name="Name" type="pi:Max70Text"/>
      <xs:element name="Account" type="pi:AccountNumberType"/>
      <xs:element name="BankCode" type="pi:BankCodeType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="TransferType">
    <xs:sequence>
      <xs:element name="EndToEndId" type="pi:Max35Text"/>
      <xs:element name="Amount" type="pi:AmountType"/>
      <xs:element name="Creditor" type="pi:AccountHolderType"/>
      <xs:element name="RemittanceInfo" type="pi:Max140Text" minOccurs="0"/>
      <xs:element name="ExecutionDate" type="xs:date"/>
    </xs:sequence>
    <xs:attribute name="urgent" type="xs:boolean" default="false"/>
  </xs:complexType>
  <xs:simpleType name="Max35Text">
    <xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="35"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Max70Text">
    <xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="70"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Max140Text">
    <xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="140"/></xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="AmountType">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0.01"/>
      <xs:totalDigits value="18"/>
      <xs:fractionDigits value="2"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="AccountNumberType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{2}[0-9]{2}[A-Z0-9]{8,26}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="BankCodeType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z]{6}[A-Z0-9]{2}([A-Z0-9]{3})?"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
