<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:n1="urn:example:multi:n1" targetNamespace="urn:example:multi:n1" elementFormDefault="qualified">
  <xs:complexType name="TravellerType">
    <xs:sequence>
      <xs:element name="fullName" type="xs:string"/>
      <xs:element name="employeeNumber" type="n1:EmployeeNumberType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="EmployeeNumberType">
    <xs:restriction base="xs:string"><xs:pattern value="E[0-9]{6}"/></xs:restriction>
  </xs:simpleType>
</xs:schema>
