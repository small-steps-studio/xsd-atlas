<?xml version="1.0" encoding="UTF-8"?>
<!-- Import chain: shipment imports party, party imports common. Three namespaces. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:sh="urn:example:logistics:shipment:3"
           xmlns:pty="urn:example:logistics:party:2"
           xmlns:cmn="urn:example:logistics:common:1"
           targetNamespace="urn:example:logistics:shipment:3"
           elementFormDefault="qualified" version="3.1">
  <xs:import namespace="urn:example:logistics:party:2" schemaLocation="06-party.xsd"/>
  <xs:import namespace="urn:example:logistics:common:1" schemaLocation="06-common.xsd"/>
  <xs:element name="shipmentNotice" type="sh:ShipmentNoticeType"/>
  <xs:complexType name="ShipmentNoticeType">
    <xs:sequence>
      <xs:element name="noticeId" type="cmn:IdentifierType"/>
      <xs:element name="shipper" type="pty:PartyType"/>
      <xs:element name="consignee" type="pty:PartyType"/>
      <xs:element name="package" type="sh:PackageType" maxOccurs="unbounded"/>
      <xs:element name="totalWeight" type="cmn:WeightType"/>
    </xs:sequence>
    <xs:attribute name="created" type="xs:dateTime" use="required"/>
  </xs:complexType>
  <xs:complexType name="PackageType">
    <xs:sequence>
      <xs:element name="trackingCode" type="cmn:IdentifierType"/>
      <xs:element name="weight" type="cmn:WeightType"/>
      <xs:element name="content" type="xs:string" minOccurs="0" maxOccurs="20"/>
    </xs:sequence>
    <xs:attribute name="fragile" type="xs:boolean" default="false"/>
  </xs:complexType>
</xs:schema>
