<?xml version="1.0" encoding="UTF-8"?>
<!-- Nillable elements, default and fixed values on elements and attributes. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:nd="urn:example:defaults:subscription"
           targetNamespace="urn:example:defaults:subscription"
           elementFormDefault="qualified">
  <xs:element name="subscription">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="plan" type="xs:token" default="standard"/>
        <xs:element name="seats" type="xs:positiveInteger" default="1"/>
        <xs:element name="cancelledOn" type="xs:date" nillable="true"/>
        <xs:element name="formatVersion" type="xs:string" fixed="2"/>
        <xs:element name="renewal" nillable="true" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="nextDate" type="xs:date"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="schemaVersion" type="xs:decimal" fixed="1.0"/>
      <xs:attribute name="trial" type="xs:boolean" default="false"/>
    </xs:complexType>
  </xs:element>
</xs:schema>
