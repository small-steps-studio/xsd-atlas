<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:n3="urn:example:multi:n3" targetNamespace="urn:example:multi:n3" elementFormDefault="qualified">
  <xs:complexType name="HotelType">
    <xs:sequence>
      <xs:element name="hotelName" type="xs:string"/>
      <xs:element name="nights" type="xs:positiveInteger"/>
    </xs:sequence>
    <xs:attribute name="breakfast" type="xs:boolean" default="false"/>
  </xs:complexType>
</xs:schema>
